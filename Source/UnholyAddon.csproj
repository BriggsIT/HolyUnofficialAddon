<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>UnholyAddon</AssemblyName>
    <RootNamespace>HolyAddon</RootNamespace>
    <Product>Unholy Addon</Product>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.35.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Where Mad Games Tycoon 2 is installed; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Mad Games Tycoon 2</GameDir>
    <Managed>$(GameDir)\Mad Games Tycoon 2_Data\Managed</Managed>
    <PluginFolder>UnholyAddon</PluginFolder>
    <!-- A copy of what goes into the game folder; override with -p:PackageDir=... -->
    <PackageDir Condition="'$(PackageDir)' == ''">$(MSBuildThisFileDirectory)..\UnholyAddon\BepInEx\plugins\$(PluginFolder)</PackageDir>
    <InstallDir>$(GameDir)\BepInEx\plugins\$(PluginFolder)</InstallDir>
    <!-- Up to 0.6.0 the mod was called "Editor" and installed here; it has to go, or both copies load. Up to 0.35.0 it
         was the "Holy Unofficial Addon" in plugins\HolyUnofficialAddon: Plugin.cs won't start while that DLL is there. -->
    <OldInstallDir>$(GameDir)\BepInEx\plugins\Editor</OldInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(Managed)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(Managed)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files that ship next to UnholyAddon.dll. Assets\icon.png is drawn by Assets\draw-icon.ps1,
         the review logos by Assets\reviews\draw-logos.ps1, the company logos by Assets\logos\render-logos.ps1. -->
    <PluginFiles Include="$(TargetPath);$(MSBuildThisFileDirectory)Assets\icon.png;$(MSBuildThisFileDirectory)Assets\contracts.png" />
    <ReviewFiles Include="$(MSBuildThisFileDirectory)Assets\reviews\reviews.json" />
    <ReviewLogos Include="$(MSBuildThisFileDirectory)Assets\reviews\logos\*.png" />
    <CompanyLogos Include="$(MSBuildThisFileDirectory)Assets\logos\logos.json;$(MSBuildThisFileDirectory)Assets\logos\png\*.png" />
    <!-- Update type icons, drawn by Assets\icons\update-icons.html, and the design assistant's buttons, by
     Assets\icons\design-icons.html (render with Assets\logos\render-logos.ps1 -Page ...). -->
    <UpdateIcons Include="$(MSBuildThisFileDirectory)Assets\icons\png\*.png" />
    <!-- Store logos (yours and the rival stores'), drawn by Assets\store\store-logos.html. -->
    <StoreLogos Include="$(MSBuildThisFileDirectory)Assets\store\png\*.png" />
    <!-- Landmark games: the list, and the pictures put in Assets\landmarks\pictures\<landmark>\ (kept out of the
         public repo by Publish-Repo.ps1 unless it's run with -Pictures). -->
    <LandmarkData Include="$(MSBuildThisFileDirectory)Assets\landmarks\landmarks.json" />
    <LandmarkPictures Include="$(MSBuildThisFileDirectory)Assets\landmarks\pictures\**\*.png;$(MSBuildThisFileDirectory)Assets\landmarks\pictures\**\*.jpg;$(MSBuildThisFileDirectory)Assets\landmarks\pictures\**\*.jpeg" />
    <!-- Third and fourth topics: the themes each topic has, for judging how topics go together. -->
    <TopicData Include="$(MSBuildThisFileDirectory)Assets\topics\topic-themes.json" />
    <!-- Studios the addon adds for the 2010s landmarks (Core\Studios\ExtraStudios.cs), and their logos made by
         Assets\studios\Make-StudioLogos.ps1 (real logos from Wikipedia: kept out of the public repo like the pictures). -->
    <StudioData Include="$(MSBuildThisFileDirectory)Assets\studios\studios.json" />
    <StudioLogos Include="$(MSBuildThisFileDirectory)Assets\studios\logos\**\*.png" />
  </ItemGroup>

  <!-- Copy the built mod into the distributable package folder (same layout as the other mods). -->
  <Target Name="Package" AfterTargets="Build">
    <MakeDir Directories="$(PackageDir)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="@(ReviewFiles)" DestinationFolder="$(PackageDir)\reviews" />
    <Copy SourceFiles="@(ReviewLogos)" DestinationFolder="$(PackageDir)\reviews\logos" />
    <Copy SourceFiles="@(CompanyLogos)" DestinationFolder="$(PackageDir)\logos" />
    <Copy SourceFiles="@(UpdateIcons)" DestinationFolder="$(PackageDir)\icons" />
    <Copy SourceFiles="@(StoreLogos)" DestinationFolder="$(PackageDir)\store" />
    <Copy SourceFiles="@(LandmarkData)" DestinationFolder="$(PackageDir)\landmarks" />
    <CallTarget Targets="PrunePackagePictures" />
    <Copy SourceFiles="@(LandmarkPictures)" DestinationFolder="$(PackageDir)\landmarks\pictures\%(RecursiveDir)" />
    <Copy SourceFiles="@(TopicData)" DestinationFolder="$(PackageDir)\topics" />
    <Copy SourceFiles="@(StudioData)" DestinationFolder="$(PackageDir)\studios" />
    <Copy SourceFiles="@(StudioLogos)" DestinationFolder="$(PackageDir)\studios\logos\%(RecursiveDir)" />
  </Target>

  <!-- Pictures the picture tools made (C:\MGTMod\PictureTools: lb-* from LaunchBox, pick-* picked by hand) that were
       since rejected or undone in Assets go from the package and the game too. Any other picture there is left alone:
       players can put their own straight into the game's folder. -->
  <Target Name="PrunePackagePictures">
    <ItemGroup>
      <_PackagedToolPictures Include="$(PackageDir)\landmarks\pictures\**\lb-*.png;$(PackageDir)\landmarks\pictures\**\lb-*.jpg;$(PackageDir)\landmarks\pictures\**\lb-*.jpeg;$(PackageDir)\landmarks\pictures\**\pick-*.png;$(PackageDir)\landmarks\pictures\**\pick-*.jpg;$(PackageDir)\landmarks\pictures\**\pick-*.jpeg" />
      <_StalePackagedPictures Include="@(_PackagedToolPictures)" Condition="!Exists('$(MSBuildThisFileDirectory)Assets\landmarks\pictures\%(_PackagedToolPictures.RecursiveDir)%(_PackagedToolPictures.Filename)%(_PackagedToolPictures.Extension)')" />
    </ItemGroup>
    <Delete Files="@(_StalePackagedPictures)" />
  </Target>

  <Target Name="PruneInstalledPictures">
    <ItemGroup>
      <_InstalledToolPictures Include="$(InstallDir)\landmarks\pictures\**\lb-*.png;$(InstallDir)\landmarks\pictures\**\lb-*.jpg;$(InstallDir)\landmarks\pictures\**\lb-*.jpeg;$(InstallDir)\landmarks\pictures\**\pick-*.png;$(InstallDir)\landmarks\pictures\**\pick-*.jpg;$(InstallDir)\landmarks\pictures\**\pick-*.jpeg" />
      <_StaleInstalledPictures Include="@(_InstalledToolPictures)" Condition="!Exists('$(MSBuildThisFileDirectory)Assets\landmarks\pictures\%(_InstalledToolPictures.RecursiveDir)%(_InstalledToolPictures.Filename)%(_InstalledToolPictures.Extension)')" />
    </ItemGroup>
    <Delete Files="@(_StaleInstalledPictures)" />
  </Target>

  <!-- dotnet build -t:Install copies the package straight into the game. -->
  <Target Name="Install" DependsOnTargets="Build">
    <RemoveDir Directories="$(OldInstallDir)" Condition="Exists('$(OldInstallDir)\Editor.dll')" />
    <MakeDir Directories="$(InstallDir)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(InstallDir)" />
    <Copy SourceFiles="@(ReviewFiles)" DestinationFolder="$(InstallDir)\reviews" />
    <Copy SourceFiles="@(ReviewLogos)" DestinationFolder="$(InstallDir)\reviews\logos" />
    <Copy SourceFiles="@(CompanyLogos)" DestinationFolder="$(InstallDir)\logos" />
    <Copy SourceFiles="@(UpdateIcons)" DestinationFolder="$(InstallDir)\icons" />
    <Copy SourceFiles="@(StoreLogos)" DestinationFolder="$(InstallDir)\store" />
    <Copy SourceFiles="@(LandmarkData)" DestinationFolder="$(InstallDir)\landmarks" />
    <CallTarget Targets="PruneInstalledPictures" />
    <Copy SourceFiles="@(LandmarkPictures)" DestinationFolder="$(InstallDir)\landmarks\pictures\%(RecursiveDir)" />
    <Copy SourceFiles="@(TopicData)" DestinationFolder="$(InstallDir)\topics" />
    <Copy SourceFiles="@(StudioData)" DestinationFolder="$(InstallDir)\studios" />
    <Copy SourceFiles="@(StudioLogos)" DestinationFolder="$(InstallDir)\studios\logos\%(RecursiveDir)" />
    <Message Importance="high" Text="Installed UnholyAddon.dll,icons, reviews, company and store logos, landmarks, topics, studios into $(InstallDir)" />
  </Target>
</Project>
